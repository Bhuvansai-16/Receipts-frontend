{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://CLOUD-RUN-SERVICE-URL/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
